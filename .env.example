# ---------------------------------------------------------------------------
# Pingexa configuration.
#
# Copy to `.env` for local development:  cp .env.example .env
# The values below match docker-compose.dev.yml, which is DEVELOPMENT ONLY.
# Never commit a real `.env`. Every secret here must be replaced in production.
# ---------------------------------------------------------------------------

# ---- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the Express API listens on.
API_PORT=4000
# Address the API binds to. Use 127.0.0.1 locally; behind a reverse proxy in
# production bind to 0.0.0.0 (or a private interface) and let the proxy terminate TLS.
API_HOST=127.0.0.1
# debug | info | warn | error
LOG_LEVEL=info
# Pretty-print logs. Leave false in production so logs stay JSON for shipping.
LOG_PRETTY=true

# ---- URLs ------------------------------------------------------------------
# Public origin of the web app. Used to build links inside emails and to build
# the shareable status-page URL. No trailing slash.
PUBLIC_APP_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API with cookies.
# CORS and the CSRF origin check both read this. No wildcards are accepted.
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database --------------------------------------------------------------
# Postgres connection string. `?schema=public` is optional.
DATABASE_URL=postgresql://pingexa:pingexa_dev_password@127.0.0.1:55433/pingexa_dev
# Max Postgres connections held by ONE process. The API and the worker each open
# their own pool, so a 20-connection server should not see both set to 20.
DATABASE_POOL_MAX=10

# ---- Redis / queues --------------------------------------------------------
# Redis must run with maxmemory-policy=noeviction; BullMQ loses jobs otherwise.
REDIS_URL=redis://127.0.0.1:56379
# Prefix for every BullMQ key. Change it to share one Redis between environments.
QUEUE_PREFIX=pingexa

# ---- Sessions and CSRF -----------------------------------------------------
# 32+ random bytes, base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every existing session and every outstanding
# verification / password-reset link.
SESSION_SECRET=replace-me-with-at-least-32-random-characters-abcdefgh
# Session lifetime in days.
SESSION_TTL_DAYS=30
# Send cookies with the Secure attribute. MUST be true in production (HTTPS).
COOKIE_SECURE=false
# Lax | Strict | None. Use None only if the SPA is on a different site than the
# API, and then COOKIE_SECURE must also be true.
COOKIE_SAMESITE=Lax
# Optional cookie domain, e.g. .pingexa.example to share across subdomains.
# COOKIE_DOMAIN=

# ---- Proxy -----------------------------------------------------------------
# Number of reverse proxies in front of the API. 0 = none (local dev).
# Set to the real hop count in production; a wrong value lets clients spoof
# X-Forwarded-For and defeat the rate limiter.
TRUST_PROXY_HOPS=0

# ---- Monitoring ------------------------------------------------------------
# Product interval is 5 minutes. This exists so tests can run an accelerated
# schedule; leave it at 300 for normal operation.
MONITOR_INTERVAL_SECONDS=300
# How often the worker looks for due monitors.
SCHEDULER_TICK_MS=15000
# Total budget for one outbound check request.
MONITOR_TIMEOUT_MS=10000
# Response bytes read before the check is aborted. Bodies are never stored.
MONITOR_MAX_RESPONSE_BYTES=65536
# Concurrent outbound checks per worker process.
WORKER_CHECK_CONCURRENCY=5
# Concurrent email sends per worker process.
WORKER_EMAIL_CONCURRENCY=2
# User-Agent sent to monitored sites, so site owners can identify the traffic.
MONITOR_USER_AGENT=Pingexa/1.0 (+uptime monitor)

# ---- Retention -------------------------------------------------------------
CHECK_RETENTION_DAYS=7
INCIDENT_RETENTION_DAYS=90
# How often the worker runs retention cleanup.
RETENTION_INTERVAL_MS=3600000

# ---- Email (SMTP) ----------------------------------------------------------
# Local dev points at Mailpit, which accepts anything and delivers nothing.
SMTP_HOST=127.0.0.1
SMTP_PORT=58025
# true for implicit TLS (port 465). false uses STARTTLS when offered.
SMTP_SECURE=false
# Leave both blank for Mailpit. Required by real providers.
SMTP_USER=
SMTP_PASSWORD=
# Set to false ONLY for a local fake SMTP server. Must be true in production.
SMTP_REJECT_UNAUTHORIZED=false
MAIL_FROM_NAME=Pingexa
MAIL_FROM_ADDRESS=alerts@pingexa.local
# Max delivery attempts per email before it is marked FAILED.
MAIL_MAX_ATTEMPTS=5

# ---- Rate limits -----------------------------------------------------------
# Window and cap for authentication endpoints (per IP, and per account for login).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
# Window and cap for the general authenticated API.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
# Window and cap for unauthenticated public status pages.
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60

# ---- Local demo data -------------------------------------------------------
# `npm run seed` creates this account with clearly-marked demo monitors.
# It refuses to run when NODE_ENV=production.
SEED_USER_EMAIL=demo@pingexa.local
SEED_USER_PASSWORD=demo-password-123
