{
  "name": "pingexa",
  "private": true,
  "version": "1.0.0",
  "description": "Open-source uptime monitoring for websites and APIs, with incident alerts, response-time history, and public status pages.",
  "license": "MIT",
  "author": "Dharamraj Yadav (https://github.com/Dharam-IN)",
  "homepage": "https://github.com/Dharam-IN/Pingexa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dharam-IN/Pingexa.git"
  },
  "bugs": {
    "url": "https://github.com/Dharam-IN/Pingexa/issues"
  },
  "keywords": [
    "uptime-monitoring",
    "monitoring",
    "status-page",
    "self-hosted",
    "devops",
    "typescript",
    "nodejs",
    "react",
    "postgresql",
    "redis"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate --silent && npm run build -w @pingexa/shared --silent",
    "dev:check": "node scripts/dev-env-guard.mjs",
    "dev:api": "node scripts/dev-env-guard.mjs && npm run dev -w @pingexa/api",
    "dev:worker": "node scripts/dev-env-guard.mjs && npm run dev:worker -w @pingexa/api",
    "dev:web": "npm run dev -w @pingexa/web",
    "build": "npm run build -w @pingexa/shared && npm run build -w @pingexa/api && npm run build -w @pingexa/web",
    "start:api": "npm run start -w @pingexa/api",
    "start:worker": "npm run start:worker -w @pingexa/api",
    "prisma:generate": "npm run prisma:generate -w @pingexa/api",
    "migrate:dev": "npm run migrate:dev -w @pingexa/api",
    "migrate:deploy": "npm run migrate:deploy -w @pingexa/api",
    "seed": "npm run seed -w @pingexa/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run build -w @pingexa/shared && npm run typecheck -w @pingexa/api && npm run typecheck -w @pingexa/web",
    "test:unit": "npm run test:unit -w @pingexa/api && npm run test:unit -w @pingexa/web",
    "test:integration": "npm run test:integration -w @pingexa/api",
    "test:e2e": "npm run test:e2e -w @pingexa/web",
    "test": "npm run test:unit && npm run test:integration",
    "dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f docker-compose.dev.yml stop",
    "dev:logs": "docker compose -f docker-compose.dev.yml logs -f"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
