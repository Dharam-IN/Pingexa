# ---------------------------------------------------------------------------
# Pingexa production configuration — TEMPLATE. Contains no real values.
#
# On the server:
#     cp .env.production.example .env.production
#     chown root:root .env.production && chmod 600 .env.production
#     # then fill in every value marked CHANGE ME
#
# This file lives ONLY on the server, at /opt/pingexa/.env.production. It is
# never committed (.gitignore), never sent to the Docker daemon (.dockerignore)
# and never copied into an image. docker-compose.prod.yml reads it with
# `env_file`, so the values reach the containers as environment variables at
# start time and are not baked into any layer.
#
# The API refuses to boot when NODE_ENV=production and any of these hold:
#   * COOKIE_SECURE is not true
#   * SMTP_REJECT_UNAUTHORIZED is not true
#   * PUBLIC_APP_URL uses http://
#   * TRUSTED_ORIGINS does not contain PUBLIC_APP_URL
#   * MONITOR_INTERVAL_SECONDS is not 300
#   * SESSION_SECRET still starts with "replace-me"
# That is intentional: each one is a silent security downgrade in a deployed
# system. See apps/api/src/config/env.ts.
# ---------------------------------------------------------------------------

# ---- Deployment identity ---------------------------------------------------
# The container registry and repository the images are pulled from.
REGISTRY=ghcr.io
IMAGE_REPO=dharam-in

# The immutable image tag currently deployed, always sha-<40-char commit>.
# deploy.sh rewrites this line; do not edit it by hand unless you are recovering
# a broken deploy manually. Never set this to a moving tag such as `main` —
# rollback works by pinning a previous SHA, which a moving tag cannot express.
IMAGE_TAG=sha-0000000000000000000000000000000000000000

# The last tag that passed its post-deploy health verification. deploy.sh writes
# this and rollback.sh reads it.
PREVIOUS_IMAGE_TAG=

# ---- Edge ------------------------------------------------------------------
# The public hostname. Its DNS A record must already point at this server
# before the first deploy, or Let's Encrypt cannot issue a certificate.
PINGEXA_DOMAIN=pingexa.parthavix.com
# Address Let's Encrypt uses for expiry notices. Not published anywhere.
ACME_EMAIL=CHANGE_ME@parthavix.com

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
LOG_PRETTY=false

# ---- URLs ------------------------------------------------------------------
# Defined EXACTLY ONCE. dotenv keeps the last occurrence, so a second definition
# further down this file silently wins and every emailed link points somewhere
# unintended. https, no trailing slash.
PUBLIC_APP_URL=https://pingexa.parthavix.com
# Must contain PUBLIC_APP_URL or the API will not start. Both CORS and the CSRF
# origin check read this. No wildcards.
TRUSTED_ORIGINS=https://pingexa.parthavix.com

# ---- Proxy -----------------------------------------------------------------
# Exactly one proxy (Caddy) sits in front of the API. Raise this only if you put
# something else in front as well — a CDN or another load balancer. Too low and
# every rate limit keys on Caddy's address, so one user can exhaust the
# allowance for everyone; too high and a client can forge X-Forwarded-For and
# bypass the limits entirely.
TRUST_PROXY_HOPS=1

# ---- Database --------------------------------------------------------------
# `postgres` is the compose service name on the internal network. The port is
# not published anywhere.
POSTGRES_USER=pingexa
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
POSTGRES_DB=pingexa
DATABASE_URL=postgresql://pingexa:CHANGE_ME_same_password_as_above@postgres:5432/pingexa
# Per PROCESS, not per deployment: the API and the worker each open their own
# pool, so this stack holds up to 2 x this value against Postgres.
DATABASE_POOL_MAX=10

# ---- Redis / queues --------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
REDIS_URL=redis://:CHANGE_ME_same_password_as_above@redis:6379
QUEUE_PREFIX=pingexa

# ---- Sessions and CSRF -----------------------------------------------------
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this signs everyone out AND invalidates every outstanding email
# verification and password-reset link.
SESSION_SECRET=CHANGE_ME_at_least_32_random_characters
SESSION_TTL_DAYS=30
# Enforced true in production.
COOKIE_SECURE=true
# Lax is correct here: Caddy serves the SPA and the API on one origin, so the
# session cookie is first-party.
COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=

# ---- Monitoring ------------------------------------------------------------
# The product interval. The config loader refuses any other value in production.
MONITOR_INTERVAL_SECONDS=300
SCHEDULER_TICK_MS=15000
MONITOR_TIMEOUT_MS=10000
MONITOR_MAX_RESPONSE_BYTES=65536
WORKER_CHECK_CONCURRENCY=5
WORKER_EMAIL_CONCURRENCY=2
MONITOR_USER_AGENT=Pingexa/1.0 (+uptime monitor)

# ---- Retention -------------------------------------------------------------
CHECK_RETENTION_DAYS=7
INCIDENT_RETENTION_DAYS=90
RETENTION_INTERVAL_MS=3600000

# ---- Email -----------------------------------------------------------------
# Real provider. Never Mailpit: that is a development fake which accepts
# everything and delivers nothing.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=CHANGE_ME_provider_api_key
# Enforced true in production.
SMTP_REJECT_UNAUTHORIZED=true
MAIL_FROM_NAME=Pingexa
# Must be a domain you control, with SPF and DKIM configured, or alert mail
# lands in spam — which for an uptime monitor is the same as not sending it.
MAIL_FROM_ADDRESS=CHANGE_ME@parthavix.com
MAIL_MAX_ATTEMPTS=5
# Narrowing-only recipient allowlist. Leave EMPTY in production: setting it
# would stop alert mail reaching real users. It exists so a non-production
# environment holding live provider credentials cannot mail anyone.
MAIL_RECIPIENT_ALLOWLIST=

# ---- Rate limits -----------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
# 60 is the production-sensible value. Do not raise it here; the higher value in
# a developer's .env exists only so the end-to-end suite can run.
TOKEN_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60

# ---- Backups ---------------------------------------------------------------
# Where deploy/backup.sh writes pg_dump archives, and how many days it keeps.
BACKUP_DIR=/var/backups/pingexa
BACKUP_RETENTION_DAYS=14
