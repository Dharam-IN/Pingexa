# ---------------------------------------------------------------------------
# Pingexa self-hosting configuration — TEMPLATE. Contains no real values.
#
#     cp .env.example .env
#     chmod 600 .env
#     # then fill in every value marked CHANGE ME
#
# This file is read twice, and both readings matter:
#   * Docker Compose interpolates ${VAR} in docker-compose.yml from the `.env`
#     beside it. That is where POSTGRES_PASSWORD and the port bindings come
#     from.
#   * `env_file: .env` hands the same variables to the api, worker and migrate
#     containers at start time. Nothing is baked into an image.
#
# `.env` is gitignored, and `.dockerignore` excludes `.env*` from every build
# context, so it is never sent to the Docker daemon. Keep it that way.
#
# The full guide is docs/SELF_HOSTING.md.
#
# When NODE_ENV=production the API refuses to boot if any of these hold. Each
# one is a silent security downgrade in a deployed system:
#   * COOKIE_SECURE is not true
#   * SMTP_REJECT_UNAUTHORIZED is not true
#   * PUBLIC_APP_URL uses http://
#   * TRUSTED_ORIGINS does not contain PUBLIC_APP_URL
#   * MONITOR_INTERVAL_SECONDS is not 300
#   * SESSION_SECRET still starts with "replace-me"
# See apps/api/src/config/env.ts.
# ---------------------------------------------------------------------------

# ===========================================================================
# 1. HOW THE OUTSIDE WORLD REACHES THIS STACK
# ===========================================================================

# The site address Caddy serves. Three shapes, pick one:
#
#   A real domain, for automatic HTTPS from Let's Encrypt. Its DNS must already
#   point at this host, and ports 80 and 443 must be reachable from the
#   internet before you start the stack:
#       PINGEXA_SITE_ADDRESS=uptime.example.com
#
#   Plain HTTP on port 80 inside the container, any hostname. For a local trial
#   or when your own reverse proxy terminates TLS in front of this:
#       PINGEXA_SITE_ADDRESS=http://
#
#   A locally-issued certificate, for rehearsing a production-shaped config on
#   a laptop. Pair it with PINGEXA_TLS_DIRECTIVE below:
#       PINGEXA_SITE_ADDRESS=https://localhost
PINGEXA_SITE_ADDRESS=uptime.example.com

# Leave EMPTY for Let's Encrypt (the normal case) or for plain HTTP. Set it to
# the literal string `tls internal` to use Caddy's own local CA instead — only
# useful for a local trial, because nothing else trusts that certificate.
PINGEXA_TLS_DIRECTIVE=

# Address Let's Encrypt uses for expiry notices. Not published anywhere. Only
# read when a certificate is actually being requested.
ACME_EMAIL=CHANGE_ME@example.com

# Where Caddy's ports land on the host. `<bind>:<port>` on the left; the right
# side of the mapping is fixed at 80 and 443 inside the container.
#
#   Public deployment:   0.0.0.0:80  and  0.0.0.0:443
#   Local trial or behind your own proxy:  127.0.0.1:8080 and 127.0.0.1:8443
PINGEXA_HTTP_BIND=0.0.0.0:80
PINGEXA_HTTPS_BIND=0.0.0.0:443

# ===========================================================================
# 2. URLS THE APPLICATION BUILDS
# ===========================================================================

# The public origin of the web app, exactly as a browser sees it. Used to build
# the links inside emails and the shareable status-page URL. No trailing slash.
#
# Define it EXACTLY ONCE. dotenv keeps the LAST occurrence in a file, so a
# second definition further down silently wins and every emailed link points
# somewhere unintended. That has happened; it cost an afternoon.
#
#   https://uptime.example.com        a real domain
#   http://localhost:8080             the plain-HTTP local trial
#   https://localhost:8443            the local-certificate trial
PUBLIC_APP_URL=https://uptime.example.com

# Comma-separated browser origins allowed to call the API with cookies. CORS
# and the CSRF origin check both read this. No wildcards are accepted, and it
# MUST contain PUBLIC_APP_URL or the API will not start in production.
TRUSTED_ORIGINS=https://uptime.example.com

# ===========================================================================
# 3. RUNTIME
# ===========================================================================

# production switches on the refusals listed at the top of this file. Use it
# for anything reachable by another person.
NODE_ENV=production
# debug | info | warn | error
LOG_LEVEL=info
LOG_PRETTY=false

# The number of reverse proxies in front of the API.
#   1  this stack's Caddy alone (the normal case)
#   2  Caddy plus your own nginx/Traefik/CDN in front of it
# Too low and every rate limit keys on Caddy's address, so one user can exhaust
# the allowance for everyone. Too high and a client can forge X-Forwarded-For
# and bypass the limits entirely. Count the hops and set it exactly.
TRUST_PROXY_HOPS=1

# Shown on GET /api/health so you can tell which build is running. Anything you
# like — a git SHA, a date, a version.
PINGEXA_RELEASE=selfhost

# ===========================================================================
# 4. DATABASE
# ===========================================================================
# `postgres` is the compose service name on the internal network. The port is
# not published anywhere.
#
# Generate the password with:  openssl rand -base64 32
# It must be identical in POSTGRES_PASSWORD and inside DATABASE_URL. If it
# contains @ : / ? # or %, URL-encode it inside DATABASE_URL.
POSTGRES_USER=pingexa
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32
POSTGRES_DB=pingexa
DATABASE_URL=postgresql://pingexa:CHANGE_ME_same_password_as_above@postgres:5432/pingexa
# Per PROCESS, not per deployment: the API and the worker each open their own
# pool, so this stack holds up to 2 x this value against Postgres.
DATABASE_POOL_MAX=10

# ===========================================================================
# 5. REDIS AND QUEUES
# ===========================================================================
# Redis must run with maxmemory-policy=noeviction; BullMQ loses jobs otherwise.
# The compose file already sets that — do not override it.
REDIS_PASSWORD=CHANGE_ME_openssl_rand_base64_32
REDIS_URL=redis://:CHANGE_ME_same_password_as_above@redis:6379
# Prefix for every BullMQ and rate-limit key.
QUEUE_PREFIX=pingexa

# ===========================================================================
# 6. SESSIONS AND COOKIES
# ===========================================================================
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# or:
#   openssl rand -base64 48
#
# Rotating this signs everyone out AND invalidates every outstanding email
# verification and password-reset link.
SESSION_SECRET=CHANGE_ME_at_least_32_random_characters
SESSION_TTL_DAYS=30
# Enforced true when NODE_ENV=production. Set false ONLY for a plain-HTTP local
# trial, and then NODE_ENV must not be production.
COOKIE_SECURE=true
# Lax is correct here: Caddy serves the SPA and the API on one origin, so the
# session cookie is first-party.
COOKIE_SAMESITE=Lax
# Set only if you need the session across subdomains, e.g. .example.com
# COOKIE_DOMAIN=

# ===========================================================================
# 7. EMAIL
# ===========================================================================
# Pingexa speaks plain SMTP. ANY standards-compliant provider works — there is
# no provider SDK and no HTTP API client in the codebase. Postmark, Mailgun,
# SendGrid, Amazon SES, Fastmail, Resend, or your own Postfix are all just
# host/port/user/password here.
#
# Two settings that waste an afternoon if you get them wrong:
#   * SMTP_USER gates authentication entirely. The transport only builds an
#     auth block when SMTP_USER is non-empty, so setting only SMTP_PASSWORD
#     configures NO auth and the provider will refuse the session.
#   * MAIL_FROM_ADDRESS must be on a domain you control, with SPF and DKIM
#     configured. Otherwise alert mail lands in spam — which, for an uptime
#     monitor, is the same as not sending it.
#
# Worked examples (one verified, the rest are the providers' documented
# settings — check them against your provider's current docs):
#
#   Resend       host smtp.resend.com  port 465  secure=true   user: the
#                literal `resend`, password: your API key.  VERIFIED against a
#                real mailbox on 2026-09-16; see docs/PROGRESS.md.
#   Postmark     host smtp.postmarkapp.com  port 587  secure=false
#                user and password: your Server API token.
#   Mailgun      host smtp.mailgun.org  port 587  secure=false
#   Amazon SES   host email-smtp.<region>.amazonaws.com  port 587  secure=false
#   SendGrid     host smtp.sendgrid.net  port 587  secure=false
#                user: the literal `apikey`, password: your API key.
#
# Only the WORKER sends mail; the API just enqueues it.
SMTP_HOST=CHANGE_ME_smtp_host
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_smtp_username
SMTP_PASSWORD=CHANGE_ME_smtp_password
# Enforced true when NODE_ENV=production. Never set this false against a real
# provider: any certificate would then be accepted.
SMTP_REJECT_UNAUTHORIZED=true
MAIL_FROM_NAME=Pingexa
MAIL_FROM_ADDRESS=CHANGE_ME@example.com
# Max SMTP transactions per alert before the row is marked FAILED.
MAIL_MAX_ATTEMPTS=5
# Narrowing-only recipient allowlist. Leave EMPTY in a real deployment: setting
# it would stop alert mail reaching your users. It exists so a staging
# environment holding live provider credentials cannot mail a stranger. It can
# only ever REMOVE recipients, never add one.
MAIL_RECIPIENT_ALLOWLIST=

# ===========================================================================
# 8. MONITORING
# ===========================================================================
# The product interval. The config loader refuses any other value in
# production. It exists only so tests can run an accelerated schedule.
MONITOR_INTERVAL_SECONDS=300
# How often the worker looks for due monitors. A check can fire this late.
SCHEDULER_TICK_MS=15000
# Total budget for one outbound check request.
MONITOR_TIMEOUT_MS=10000
# Response bytes read before the check is aborted. Bodies are never stored.
MONITOR_MAX_RESPONSE_BYTES=65536
# Concurrent outbound checks per worker process.
WORKER_CHECK_CONCURRENCY=5
# Concurrent email sends per worker process.
WORKER_EMAIL_CONCURRENCY=2
# Sent to every monitored site, so site owners can identify the traffic. Adding
# a contact URL is good manners on a public instance.
MONITOR_USER_AGENT=Pingexa/1.0 (+uptime monitor)

# ===========================================================================
# 9. RETENTION
# ===========================================================================
CHECK_RETENTION_DAYS=7
INCIDENT_RETENTION_DAYS=90
RETENTION_INTERVAL_MS=3600000

# ===========================================================================
# 10. RATE LIMITS
# ===========================================================================
# Backed by Redis, so they hold across API instances. See docs/API.md for what
# each bucket is keyed on.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
# Token redemption (verify-email, reset confirm) gets its own looser per-IP
# bucket: those requests carry no email address, and a token is 256 bits of
# randomness, so this is about request volume rather than brute force.
TOKEN_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60

# ===========================================================================
# 11. OPTIONAL: the Mailpit trial
# ===========================================================================
# Only when you start the stack with `--profile mailpit`. Where the Mailpit web
# UI lands on the host. The SMTP port is never published.
PINGEXA_MAILPIT_UI_BIND=127.0.0.1:8125
