# ---------------------------------------------------------------------------
# Pingexa edge proxy — self-hosting stack.
#
# One origin serves both the SPA and the API. That is not an arbitrary choice:
# apps/web/src/lib/api.ts falls back to an empty API base, so the browser calls
# /api on whatever origin served the page. Single-origin also means the session
# cookie stays first-party and COOKIE_SAMESITE=Lax is sufficient.
#
# This file is the self-hosting stack's own copy. The maintainer production
# stack uses ../Caddyfile; changing one must never change the other.
#
# Three deployments come out of one variable, PINGEXA_SITE_ADDRESS:
#
#   unset            ->  http://            plain HTTP on :80, any hostname.
#                        For a local trial, or when your own reverse proxy in
#                        front of this terminates TLS. Remember to raise
#                        TRUST_PROXY_HOPS to 2 in that case: Caddy is one hop
#                        and your proxy is another.
#
#   uptime.example.com  ->  automatic HTTPS from Let's Encrypt. The domain's
#                        DNS must already point at this host and ports 80 and
#                        443 must be reachable from the internet, or the
#                        certificate cannot be issued.
#
#   https://localhost   ->  with PINGEXA_TLS_DIRECTIVE="tls internal", Caddy
#                        issues a certificate from its own local CA. Useful for
#                        rehearsing a production-shaped configuration
#                        (COOKIE_SECURE=true, https:// links) on a laptop. The
#                        certificate is not trusted by anything else, so
#                        browsers and curl will warn.
# ---------------------------------------------------------------------------
{
	# Only used when a certificate is actually being requested from Let's
	# Encrypt. Harmless otherwise.
	email {$ACME_EMAIL:selfhost@localhost}

	# Used by the container healthcheck. Bound to localhost inside the
	# container only; it is not reachable from the network.
	admin 127.0.0.1:2019
}

{$PINGEXA_SITE_ADDRESS:http://} {
	# Empty by default. Set PINGEXA_TLS_DIRECTIVE="tls internal" to use Caddy's
	# local CA instead of Let's Encrypt.
	{$PINGEXA_TLS_DIRECTIVE}

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		# Caddy advertises itself otherwise.
		-Server
	}

	# The API. `handle` (not `handle_path`) keeps the /api prefix, because the
	# Express app mounts its routers at /api and the SPA calls /api/... on this
	# same origin.
	handle /api/* {
		reverse_proxy api:4000 {
			# Exactly one proxy sits in front of the API here, which is why the
			# application is configured with TRUST_PROXY_HOPS=1. If you put
			# anything else in front of this — a CDN, another load balancer —
			# raise that value to match, or the IP-keyed rate limits can be
			# bypassed with a forged X-Forwarded-For.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}

			# The API sets requestTimeout to 30s; give it room to answer.
			transport http {
				dial_timeout 5s
				response_header_timeout 35s
			}
		}
	}

	# Everything else is the SPA, including the client-side routes behind
	# emailed links (/verify-email, /reset-password) and the public status
	# pages (/status/:slug). The nginx container does the SPA fallback.
	handle {
		reverse_proxy web:8080
	}
}

# There is deliberately no separate http:// block for the HTTPS case. Caddy
# already installs the HTTP->HTTPS redirect and the ACME HTTP-01 challenge
# handler on port 80 for any site it serves over TLS; adding one by hand
# replaces that with a plain HTTP server.
#
# HSTS is deliberately NOT set here, unlike the maintainer production
# Caddyfile. A self-hoster may be on plain HTTP, on a local certificate, or
# sharing a parent domain with something else, and an accidental two-year
# includeSubDomains pin is very hard to undo. Add it yourself once you are
# settled on HTTPS:
#
#     header Strict-Transport-Security "max-age=63072000; includeSubDomains"
